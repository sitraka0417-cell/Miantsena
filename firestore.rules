rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un compte est autorisé s'il existe un document autorises/{email en minuscules}
    function autorise() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/autorises/$(request.auth.token.email.lower()));
    }

    // Liste blanche : chacun peut seulement vérifier SA propre entrée ; écriture uniquement depuis la console Firebase
    match /autorises/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // Données synchronisées : réservées au propriétaire ET autorisé
    match /utilisateurs/{uid}/projets/{projetId} {
      allow read, write: if autorise() && request.auth.uid == uid;
    }
  }
}
