<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp"><shape android:shape="rectangle"><solid android:color="#3730A3" /><corners android:radius="16dp" /></shape></item>
            <item android:top="3dp" android:bottom="1dp"><shape android:shape="rectangle"><gradient android:startColor="#6366F1" android:endColor="#7C3AED" android:angle="270" /><corners android:radius="16dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp"><shape android:shape="rectangle"><solid android:color="#3730A3" /><corners android:radius="16dp" /></shape></item>
            <item android:bottom="4dp"><shape android:shape="rectangle"><gradient android:startColor="#6366F1" android:endColor="#7C3AED" android:angle="270" /><corners android:radius="16dp" /></shape></item>
        </layer-list>
    </item>
</selector>
